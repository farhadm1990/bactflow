#!/usr/bin/env bash
# Minimal conda CLI so BactFlow scripts keep working in Docker
# (the runtime env is already on PATH; there is no full Conda install).
set -euo pipefail

CONDA_BASE="/opt/conda"
CONDA_ENV="${CONDA_BASE}/envs/bactflow"
CONDA_MLST_ENV="${CONDA_BASE}/envs/bactflow_mlst"

cmd="${1:-}"
shift || true

case "${cmd}" in
    info)
        if [ "${1:-}" = "--base" ]; then
            printf '%s\n' "${CONDA_BASE}"
            exit 0
        fi
        printf 'conda stub (docker)\nbase env: %s\n' "${CONDA_ENV}"
        ;;
    activate|deactivate)
        # In-shell activate lives in conda.sh (sourced). This binary is a
        # no-op when invoked as a subprocess; scripts should source conda.sh.
        exit 0
        ;;
    config)
        exit 0
        ;;
    env)
        sub="${1:-}"
        shift || true
        if [ "${sub}" = "list" ]; then
            if [ "${1:-}" = "--json" ] || [ "${2:-}" = "--json" ]; then
                if [ -d "${CONDA_MLST_ENV}" ]; then
                    printf '{"envs":["%s","%s"]}\n' "${CONDA_ENV}" "${CONDA_MLST_ENV}"
                else
                    printf '{"envs":["%s"]}\n' "${CONDA_ENV}"
                fi
            else
                printf '# conda environments:\n'
                printf 'bactflow              *  %s\n' "${CONDA_ENV}"
                if [ -d "${CONDA_MLST_ENV}" ]; then
                    printf 'bactflow_mlst            %s\n' "${CONDA_MLST_ENV}"
                fi
            fi
            exit 0
        fi
        exit 0
        ;;
    --version|-V)
        printf 'conda 24.0.0 (docker stub)\n'
        ;;
    *)
        exit 0
        ;;
esac
